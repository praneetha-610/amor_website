# ───────────────────────────────────────────────────────────────
# AMOR FATI — environment variables
# Copy to .env.local (development) or add in your host's dashboard.
# ───────────────────────────────────────────────────────────────

# Public URL of the site (used for Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase (REAL MODE) ────────────────────────────────────────
# Leave both blank to run in DEMO MODE (in-memory data, loud banner).
# Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin (/admin) ──────────────────────────────────────────────
# Shared staff password. Use a long random string (20+ chars).
ADMIN_PASSWORD=

# ── Signing secret ──────────────────────────────────────────────
# Signs admin sessions and confirmation links. Generate with:
#   openssl rand -hex 32
APP_SECRET=

# ── Demo mode switches ──────────────────────────────────────────
# In production, demo mode is refused unless you explicitly allow it.
DEMO_MODE=
# Set to "false" to start demo mode with empty inventory (30/30 everywhere).
DEMO_SEED=true
